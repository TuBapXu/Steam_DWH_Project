# ==============================================================================
# STEAM GAMES DATA WAREHOUSE & BUSINESS INTELLIGENCE PLATFORM
# CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example) - SẴN SÀNG ĐỂ CHẠY & NỘP ĐỒ ÁN
# ==============================================================================
# Hướng dẫn nhanh cho Thầy/Cô và Người chấm đồ án:
# 1. Để chạy toàn bộ hệ thống bằng Docker & Python:
#    - Trên Windows (PowerShell): Copy-Item .env.example .env
#    - Trên Linux / macOS:      cp .env.example .env
# 2. File này ĐÃ ĐIỀN SẴN Mật khẩu SQL Server và Gemini API Key hợp lệ.
#    Thầy/Cô chỉ cần copy sang file .env là có thể chạy ngay toàn bộ hệ thống:
#    - Mage ETL Orchestrator (Port 6790)
#    - SQL Server Data Warehouse (Port 1435)
#    - AI Copilot Trợ lý ảo Trí tuệ Doanh nghiệp (Port 5000)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu hình Cơ sở dữ liệu Microsoft SQL Server (Docker Container)
# ------------------------------------------------------------------------------
MSSQL_PASSWORD=thanhtu185B#2005
MSSQL_HOST=sqlserver
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_LOCAL_HOST=localhost
MSSQL_LOCAL_PORT=1435
DWH_DATABASE=steam_games_DWH
STAGING_DATABASE=steam_games_DWH
STAGING_SCHEMA=dbo
DBT_SCHEMA=dbt_staging
DBT_TARGET=dev

# ------------------------------------------------------------------------------
# 2. Cổng truy cập Mage AI Orchestrator UI trên máy Host
# ------------------------------------------------------------------------------
STEAM_MAGE_PORT=6790

# ------------------------------------------------------------------------------
# 3. Cấu hình AI Copilot (Steam Business Intelligence Assistant)
# File này đã tích hợp sẵn Gemini API Key để Thầy/Cô trải nghiệm trực tiếp
# khả năng phân tích kinh doanh, dự báo xu hướng và giải đáp số liệu tự động.
# (Hệ thống cũng hỗ trợ Dual-Engine: nếu không có mạng / key, Copilot vẫn tự động
# truy vấn Grounding Data trực tiếp từ kho dbo.dashboard_ai_insights trong SQL Server).
# ------------------------------------------------------------------------------
GEMINI_API_KEY="AQ.Ab8RN6L_oYEtcnUgYcBlHLWChmcXu6QiusQAfUHxZ_nQwEMa7Q"
OPENAI_API_KEY=""
