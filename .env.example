# MSSQL_LOCAL_PORT=1435
# DWH_DATABASE=steam_games_DWH
# STAGING_DATABASE=steam_games_DWH
# STAGING_SCHEMA=dbo
# DBT_SCHEMA=dbt_staging
# DBT_TARGET=dev
