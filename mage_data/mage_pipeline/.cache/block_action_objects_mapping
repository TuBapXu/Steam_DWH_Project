{"block_file": {"data_loaders/create_watermark_and_audit_table.sql:data_loader:sql:create watermark and audit table": {"content": "-- Docs: https://docs.mage.ai/guides/sql-blocks\n", "file_path": "data_loaders/create_watermark_and_audit_table.sql", "language": "sql", "type": "data_loader", "uuid": "create_watermark_and_audit_table"}, "data_loaders/extract_steam_games.py:data_loader:python:extract steam games": {"content": "import pandas as pd\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.mssql import MSSQL\nfrom mage_ai.settings.repo import get_repo_path\nfrom os import path\nif 'data_loader' not in globals():\n    from mage_ai.data_preparation.decorators import data_loader\n\n@data_loader\ndef load_data_from_file(*args, **kwargs):\n    #Lay bien tu giao dien\n    run_mode = kwargs.get('run_mode', 'incremental')\n    demo_lset = kwargs.get('demo_lset', None)\n    demo_cet = kwargs.get('demo_cet', None)\n\n    print(f\"--- B\u1eaft \u0111\u1ea7u ch\u1ea1y ch\u1ebf \u0111\u1ed9: {run_mode.upper()} LOAD ---\")\n\n    #Doc file csv goc\n    file_path = '/home/src/data/games.csv'\n    df = pd.read_csv(file_path)\n    df['Release date'] = pd.to_datetime(df['Release date'], errors='coerce')\n\n    #Phan nhan full load - incremental load\n    if run_mode == 'full':\n        print(f\"\u0110ang ch\u1ea1y FULL LOAD: Tr\u00edch xu\u1ea5t to\u00e0n b\u1ed9 {len(df)} d\u00f2ng, b\u1ecf qua Watermark.\")\n        return df\n    if demo_lset and demo_cet:\n        lset = pd.to_datetime(demo_lset)\n        cet = pd.to_datetime(demo_cet)\n        print(f\"[Ch\u1ebf \u0111\u1ed9 DEMO] C\u1eaft l\u00e1t th\u1ee7 c\u00f4ng t\u1eeb {lset} \u0111\u1ebfn {cet}\")\n    else:\n        print(\">> \u0110ang k\u1ebft n\u1ed1i SQL Server...\")\n        print(\"[Ch\u1ebf d\u1ed9 th\u1ef1c t\u1ebf] \u0110ang t\u1ef1 \u0111\u1ed9ng truy v\u1ea5n LSET t\u1eeb SQL server...\")\n        config_path = path.join(get_repo_path(), 'io_config.yaml')\n        query_lset = \"SELECT lset FROM etl_watermark Where table_name = 'stg_steam_games'\"\n        with MSSQL.with_config(ConfigFileLoader(config_path, 'default')) as db:\n            result = db.execute_query(query_lset)\n            lset_str = result[0][0] if result else '1990-01-01'\n\n        lset = pd.to_datetime(lset_str)\n        cet = lset + pd.DateOffset(years=2)\n\n    #Loc du lieu lset < batch_df <= cet\n    batch_df = df[(df['Release date'] > lset) & (df['Release date'] <= cet)]\n    print(f\"Ho\u00e0n t\u1ea5t! \u0110\u00e3 tr\u00edch xu\u1ea5t {len(batch_df)} t\u1ef1a game cho batch n\u00e0y\")\n    return batch_df\n", "file_path": "data_loaders/extract_steam_games.py", "language": "python", "type": "data_loader", "uuid": "extract_steam_games"}, "data_loaders/fdfd.py:data_loader:python:fdfd": {"content": "import os\npw = os.getenv(\"MSSQL_PASSWORD\")\nprint(repr(pw))", "file_path": "data_loaders/fdfd.py", "language": "python", "type": "data_loader", "uuid": "fdfd"}, "data_loaders/load_steam_games_csv.py:data_loader:python:load steam games csv": {"content": "import pandas as pd\nif 'data_loader' not in globals():\n    from mage.ai.data_preparation.decorators import data_loader\n\n\n@data_loader\ndef load_data_from_file(*args, **kwargs):\n    load_stategy = kwargs.get('load_stategy', 'full')\n\n    print(f\"B\u1eaft \u0111\u1ea7u qu\u00e1 tr\u00ecnh Ingestion v\u1edbi ch\u1ebf \u0111\u1ed9: {load_stategy.upper()} LOAD\")\n\n    file_path = '/home/src/data/games.csv'\n\n    df = pd.read_csv(file_path)\n\n    if load_stategy == 'incremental'\n    df['Release date'] = pd.to_datetime(df['Release date'], errors='coerce')\n    df\n\n\n@test\ndef test_output(output, *args) -> None:\n    \"\"\"\n    Template code for testing the output of the block.\n    \"\"\"\n    assert output is not None, 'The output is undefined'\n", "file_path": "data_loaders/load_steam_games_csv.py", "language": "python", "type": "data_loader", "uuid": "load_steam_games_csv"}, "pipelines/steam_staging_pipeline/metadata.yaml:pipeline:yaml:steam staging pipeline/metadata": {"content": "blocks:\n- all_upstream_blocks_executed: true\n  color: null\n  configuration: {}\n  downstream_blocks: []\n  executor_config: null\n  executor_type: local_python\n  has_callback: false\n  language: python\n  name: extract_steam_games\n  retry_config: null\n  status: failed\n  timeout: null\n  type: data_loader\n  upstream_blocks: []\n  uuid: extract_steam_games\ncache_block_output_in_memory: false\ncallbacks: []\nconcurrency_config: {}\nconditionals: []\ncreated_at: '2026-10-17 14:09:28.092606+00:00'\ndata_integration: null\ndescription: ingest and load data form csv file to sel server staging\nexecutor_config: {}\nexecutor_count: 1\nexecutor_type: null\nextensions: {}\nname: steam_staging_pipeline\nnotification_config: {}\nremote_variables_dir: null\nretry_config: {}\nrun_pipeline_in_one_process: false\nsettings:\n  triggers: null\nspark_config: {}\ntags: []\ntype: python\nuuid: steam_staging_pipeline\nvariables:\n  demo_lset: '2022-01-01'\n  reun_mode: incremental\nvariables_dir: /home/src/mage_data/mage_pipeline\nwidgets: []\n", "file_path": "pipelines/steam_staging_pipeline/metadata.yaml", "language": "yaml", "type": "pipeline", "uuid": "steam_staging_pipeline/metadata"}, "pipelines/steam_staging_pipeline/__init__.py:pipeline:python:steam staging pipeline/  init  ": {"content": "", "file_path": "pipelines/steam_staging_pipeline/__init__.py", "language": "python", "type": "pipeline", "uuid": "steam_staging_pipeline/__init__"}, "/home/src/mage_pipeline/data_loaders/extract_steam_games.py:data_loader:python:home/src/mage pipeline/data loaders/extract steam games": {"content": "import pandas as pd\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.mssql import MSSQL\nfrom mage_ai.settings.repo import get_repo_path\nfrom os import path\nif 'data_loader' not in globals():\n    from mage_ai.data_preparation.decorators import data_loader\n\n@data_loader\ndef load_data_from_file(*args, **kwargs):\n    #Lay bien tu giao dien\n    run_mode = kwargs.get('run_mode', 'incremental')\n    demo_lset = kwargs.get('demo_lset', None)\n    demo_cet = kwargs.get('demo_cet', None)\n\n    print(f\"--- B\u1eaft \u0111\u1ea7u ch\u1ea1y ch\u1ebf \u0111\u1ed9: {run_mode.upper()} LOAD ---\")\n\n    # Doc file csv goc\n    file_path = '/home/src/data/games.csv'\n    COLS = ['AppID', 'Name', 'Release date', 'Estimated owners', 'Peak CCU',\n        'Required age', 'Price', 'Discount', 'DLC count', 'About the game',\n        'Supported languages', 'Full audio languages', 'Reviews', 'Header image',\n        'Website', 'Support url', 'Support email', 'Windows', 'Mac', 'Linux',\n        'Metacritic score', 'Metacritic url', 'User score', 'Positive', 'Negative',\n        'Score rank', 'Achievements', 'Recommendations', 'Notes',\n        'Average playtime forever', 'Average playtime two weeks',\n        'Median playtime forever', 'Median playtime two weeks', 'Developers',\n        'Publishers', 'Categories', 'Genres', 'Tags', 'Screenshots', 'Movies']\n\n    df = pd.read_csv(file_path, engine='python', on_bad_lines='skip', encoding='utf-8', header=0, names=COLS, quotechar='\"')\n\n    # L\u00e0m s\u1ea1ch kho\u1ea3ng tr\u1eafng (n\u1ebfu c\u00f3) v\u00e0 \u00e9p ki\u1ec3u th\u1eddi gian\n    df['Release date'] = df['Release date'].astype(str).str.strip()\n    df['Release date'] = pd.to_datetime(df['Release date'], errors='coerce')\n\n\n    #Phan nhan full load - incremental load\n    if run_mode == 'full':\n        print(f\"Ho\u00e0n t\u1ea5t FULL LOAD: Tr\u00edch xu\u1ea5t to\u00e0n b\u1ed9 {len(df)} d\u00f2ng, b\u1ecf qua Watermark.\")\n        return df\n    if demo_lset and demo_cet:\n        lset = pd.to_datetime(demo_lset)\n        cet = pd.to_datetime(demo_cet)\n        print(f\"[Ch\u1ebf \u0111\u1ed9 DEMO] C\u1eaft l\u00e1t th\u1ee7 c\u00f4ng t\u1eeb {lset} \u0111\u1ebfn {cet}\")\n    else:\n        print(\">> \u0110ang k\u1ebft n\u1ed1i SQL Server...\")\n        print(\"[Ch\u1ebf d\u1ed9 th\u1ef1c t\u1ebf] \u0110ang t\u1ef1 \u0111\u1ed9ng truy v\u1ea5n LSET t\u1eeb SQL server...\")\n        config_path = path.join(get_repo_path(), 'io_config.yaml')\n        query_lset = \"SELECT lset FROM etl_watermark Where table_name = 'stg_steam_games'\"\n        with MSSQL.with_config(ConfigFileLoader(config_path, 'default')) as db:\n            result = db.load(query_lset)\n            lset_str = result.iloc[0, 0] if not result.empty else '2010-01-01'\n\n        lset = pd.to_datetime(lset_str)\n        cet = lset + pd.DateOffset(years=2)\n\n    #Loc du lieu lset < batch_df <= cet\n    batch_df = df[(df['Release date'] > lset) & (df['Release date'] <= cet)]\n    print(f\"Ho\u00e0n t\u1ea5t! \u0110\u00e3 tr\u00edch xu\u1ea5t {len(batch_df)} t\u1ef1a game cho batch n\u00e0y\")\n    return batch_df\n", "file_path": "/home/src/mage_pipeline/data_loaders/extract_steam_games.py", "language": "python", "type": "data_loader", "uuid": "extract_steam_games"}, "/home/src/mage_pipeline/transformers/validate_clean.py:transformer:python:home/src/mage pipeline/transformers/validate clean": {"content": "import pandas as pd \n\nif 'transformer' not in globals():\n    from mage_ai.data_preparation.decorators import transformer\n\nREQUIRED = ['AppID', 'Name', 'Release date']\n\n\n@transformer\ndef validate_clean(df, *args, **kwargs):\n    \n    if df.empty:\n        print(\"Batch rong, bo qua validate.\", flush=True)\n        return df\n\n    missing = [c for c in REQUIRED if c not in df.columns]\n    if missing:\n        raise ValueError(f\"Thieu cot bat buoc: {missing}\")\n\n    rows_in = len(df)\n    df = df.copy()\n\n    df.columns = [\n        c.strip().lower().replace(' ', '_') for c in df.columns\n    ]\n\n    df['appid'] = pd.to_numeric(df['appid'], errors='coerce')\n    df['name'] = df['name'].astype(str).str.strip()\n\n    # ---------- KI\u1ec2M TRA CH\u1ea4T L\u01af\u1ee2NG ----------\n    # \u0110\u1ebfm s\u1ed1 d\u00f2ng AppID l\u1ed7i (NaN) -> s\u1ebd b\u1ecb lo\u1ea1i\n    n_bad_key = int(df['appid'].isna().sum())\n    # \u0110\u1ebfm s\u1ed1 d\u00f2ng ng\u00e0y l\u1ed7i (NaT); ch\u1ec9 ghi nh\u1eadn, KH\u00d4NG x\u00f3a\n    n_bad_date = int(df['release_date'].isna().sum())\n    # B\u1ecf c\u00e1c d\u00f2ng kh\u00f4ng c\u00f3 AppID (kh\u00f4ng c\u00f3 kh\u00f3a th\u00ec kh\u00f4ng \u0111\u1ecbnh danh \u0111\u01b0\u1ee3c)\n    df = df[df['appid'].notna()]\n\n    # \u0110\u1ebfm s\u1ed1 d\u00f2ng tr\u00f9ng AppID\n    n_dup = int(df.duplicated('appid').sum())\n    # Gi\u1eef d\u00f2ng cu\u1ed1i c\u00f9ng c\u1ee7a m\u1ed7i AppID, b\u1ecf c\u00e1c d\u00f2ng tr\u00f9ng\n    df = df.drop_duplicates('appid', keep='last')\n    #\u0111\u1ed5i appid sang s\u1ed1 nguy\u00ean cho g\u1ecdn\n    df['appid'] = df['appid'].astype('int64')\n    # C\u00e1c c\u1ed9t s\u1ed1 nguy\u00ean: \u00e9p ki\u1ec3u, gi\u00e1 tr\u1ecb l\u1ed7i th\u00e0nh NaN r\u1ed3i th\u00e0nh NULL\n    int_cols = ['peak_ccu', 'required_age', 'discount', 'dlc_count',\n                'metacritic_score', 'user_score', 'positive', 'negative',\n                'achievements', 'recommendations',\n                'average_playtime_forever', 'average_playtime_two_weeks',\n                'median_playtime_forever', 'median_playtime_two_weeks']\n    for c in int_cols:\n        df[c] = pd.to_numeric(df[c], errors='coerce').astype('Int64')  # Int64 cho ph\u00e9p NULL\n\n    df['price'] = pd.to_numeric(df['price'], errors='coerce')\n\n    # C\u1ed9t True/False -> bool (BIT)\n    for c in ['windows', 'mac', 'linux']:\n        df[c] = df[c].astype(str).str.lower().map({'true': True, 'false': False})\n\n    # score_rank h\u1ea7u h\u1ebft r\u1ed7ng, \u00e9p v\u1ec1 chu\u1ed7i \u0111\u1ec3 kh\u1edbp NVARCHAR\n    df['score_rank'] = df['score_rank'].astype('string')\n\n    # ---------- TH\u00caM C\u1ed8T METADATA ----------\n    # Th\u1eddi \u0111i\u1ec3m d\u00f2ng n\u00e0y \u0111\u01b0\u1ee3c n\u1ea1p (ph\u1ee5c v\u1ee5 audit, truy v\u1ebft)\n    df['_loaded_at'] = pd.Timestamp.now()\n    # Ch\u1ebf \u0111\u1ed9 ch\u1ea1y: full hay incremental\n    df['_run_mode'] = kwargs.get('run_mode', 'incremental')\n\n    # ----------GHI NH\u1eacN K\u1ebeT QU\u1ea2 ----------\n    print(\n        f\"Vao: {rows_in} | AppID loi: {n_bad_key} | Ngay loi: {n_bad_date} \"\n        f\"| Trung AppID: {n_dup} | Ra: {len(df)}\",\n        flush=True,  # In ngay, kh\u00f4ng b\u1ecb buffer trong Docker\n    )\n\n    return df  # Tr\u1ea3 v\u1ec1 cho block load_to_staging\n", "file_path": "/home/src/mage_pipeline/transformers/validate_clean.py", "language": "python", "type": "transformer", "uuid": "validate_clean"}, "/home/src/mage_pipeline/data_exporters/load_to_staging.py:data_exporter:python:home/src/mage pipeline/data exporters/load to staging": {"content": "import pandas as pd\nimport pyodbc\nfrom os import path\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.mssql import MSSQL\nfrom mage_ai.settings.repo import get_repo_path\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\n\n@data_exporter\ndef load_to_staging(df, *args, **kwargs):\n    run_mode = str(kwargs.get('run_mode', 'incremental')).strip().lower()\n\n    if df.empty:\n        print(\"Batch rong, khong nap gi.\", flush=True)\n        return df\n\n    # NaN/NaT/NA -> None \u0111\u1ec3 SQL Server nh\u1eadn l\u00e0 NULL\n    data = df.astype(object).where(df.notna(), None)\n\n    cols = list(df.columns)\n    col_sql = \", \".join(f\"[{c}]\" for c in cols)\n    placeholders = \", \".join(\"?\" for _ in cols)\n\n    # D\u00f9ng \u0111\u00fang c\u1ea5u h\u00ecnh \u0111\u00e3 ch\u1ea1y \u0111\u01b0\u1ee3c \u1edf c\u00e1c block kh\u00e1c\n    config = ConfigFileLoader(path.join(get_repo_path(), 'io_config.yaml'), 'default')\n\n    with MSSQL.with_config(config) as db:\n        # M\u1edf k\u1ebft n\u1ed1i ri\u00eang b\u1eb1ng connection string c\u1ee7a Mage \u0111\u1ec3 t\u1ef1 ki\u1ec3m so\u00e1t commit\n        conn = pyodbc.connect(db.connection_string, autocommit=False)\n        try:\n            cur = conn.cursor()\n\n            if run_mode == 'full':\n                cur.execute(\"TRUNCATE TABLE dbo.stg_steam_games\")\n            else:\n                ids = df['appid'].astype('int64').tolist()\n                for i in range(0, len(ids), 1000):\n                    chunk = \",\".join(str(x) for x in ids[i:i + 1000])\n                    cur.execute(f\"DELETE FROM dbo.stg_steam_games WHERE appid IN ({chunk})\")\n\n            cur.fast_executemany = True\n            cur.executemany(\n                f\"INSERT INTO dbo.stg_steam_games ({col_sql}) VALUES ({placeholders})\",\n                data.values.tolist(),\n            )\n            conn.commit()\n\n            cur.execute(\"SELECT COUNT(*) FROM dbo.stg_steam_games\")\n            total = cur.fetchone()[0]\n        except Exception:\n            conn.rollback()\n            raise\n        finally:\n            conn.close()\n\n    if total == 0:\n        raise RuntimeError(\"Nap xong nhung staging van rong\")\n\n    print(f\"Da nap {len(df)} dong | Tong dong trong staging: {total}\", flush=True)\n    return df", "file_path": "/home/src/mage_pipeline/data_exporters/load_to_staging.py", "language": "python", "type": "data_exporter", "uuid": "load_to_staging"}, "/home/src/mage_pipeline/data_exporters/update_watermark_audit.py:data_exporter:python:home/src/mage pipeline/data exporters/update watermark audit": {"content": "import pandas as pd  # X\u1eed l\u00fd b\u1ea3ng d\u1eef li\u1ec7u\nfrom os import path  # Gh\u00e9p \u0111\u01b0\u1eddng d\u1eabn file\nfrom mage_ai.io.config import ConfigFileLoader   # \u0110\u1ecdc io_config.yaml\nfrom mage_ai.io.mssql import MSSQL               # K\u1ebft n\u1ed1i SQL Server\nfrom mage_ai.settings.repo import get_repo_path  # \u0110\u01b0\u1eddng d\u1eabn g\u1ed1c project\n\nif 'data_exporter' not in globals():\n    from mage_ai.data_preparation.decorators import data_exporter\n\n\n@data_exporter  # \u0110\u00e1nh d\u1ea5u h\u00e0m ch\u00ednh c\u1ee7a block exporter\ndef update_watermark_audit(df, *args, **kwargs):\n    # df l\u00e0 DataFrame t\u1eeb load_to_staging (d\u00f9ng \u0111\u1ec3 \u0111\u1ebfm s\u1ed1 d\u00f2ng \u0111\u00e3 n\u1ea1p)\n\n    # L\u1ea5y c\u00e1c tham s\u1ed1 ch\u1ea1y t\u1eeb giao di\u1ec7n\n    run_mode = kwargs.get('run_mode', 'incremental')\n    is_demo = bool(kwargs.get('demo_lset') and kwargs.get('demo_cet'))\n\n    n_rows = len(df)  # S\u1ed1 b\u1ea3n ghi \u0111\u00e3 x\u1eed l\u00fd trong l\u1ea7n ch\u1ea1y n\u00e0y\n\n    # N\u1ea1p c\u1ea5u h\u00ecnh k\u1ebft n\u1ed1i t\u1eeb io_config.yaml\n    config = ConfigFileLoader(\n        path.join(get_repo_path(), 'io_config.yaml'), 'default'\n    )\n\n    with MSSQL.with_config(config) as db:\n\n        # ---------- 1. GHI AUDIT LOG ----------\n        # T\u00ean pipeline g\u1ed3m ch\u1ebf \u0111\u1ed9 ch\u1ea1y, v\u00ed d\u1ee5: steam_staging_full\n        pipeline_name = f\"steam_staging_{'demo' if is_demo else run_mode}\"\n        db.execute(\n            \"INSERT INTO dbo.etl_audit_log \"\n            \"(pipeline_name, run_date, status, records_processed, error_message) \"\n            f\"VALUES ('{pipeline_name}', GETDATE(), 'SUCCESS', {n_rows}, NULL)\"\n        )\n\n        # ---------- 2. D\u1edcI WATERMARK ----------\n        # Ch\u1ec9 d\u1eddi khi ch\u1ea1y incremental th\u1eadt (b\u1ecf qua full v\u00e0 demo),\n        # n\u1ebfu kh\u00f4ng s\u1ebd l\u00e0m sai m\u1ed1c c\u1ee7a c\u00e1c l\u1ea7n ch\u1ea1y sau\n        if run_mode == 'incremental' and not is_demo:\n            db.execute(\n                \"UPDATE dbo.etl_watermark \"\n                \"SET lset = DATEADD(year, 2, lset) \"\n                \"WHERE table_name = 'stg_steam_games'\"\n            )\n\n        db.commit()  # Ch\u1ed1t giao d\u1ecbch\n\n    print(f\"Audit: {pipeline_name} | {n_rows} dong | SUCCESS\", flush=True)", "file_path": "/home/src/mage_pipeline/data_exporters/update_watermark_audit.py", "language": "python", "type": "data_exporter", "uuid": "update_watermark_audit"}, "/home/src/mage_pipeline/callbacks/log_failure.py:callback:python:home/src/mage pipeline/callbacks/log failure": {"content": "from os import path\nfrom mage_ai.io.config import ConfigFileLoader\nfrom mage_ai.io.mssql import MSSQL\nfrom mage_ai.settings.repo import get_repo_path\n\nif 'callback' not in globals():\n    from mage_ai.data_preparation.decorators import callback\n\n\n@callback('failure')\ndef callback_failure(*args, **kwargs):\n    # N\u1ed9i dung l\u1ed7i; nh\u00e2n \u0111\u00f4i d\u1ea5u ' \u0111\u1ec3 kh\u00f4ng l\u00e0m h\u1ecfng c\u00e2u SQL\n    err = str(kwargs.get('error', 'unknown error'))[:1000].replace(\"'\", \"''\")\n    run_mode = str(kwargs.get('run_mode', 'incremental')).strip().lower()\n\n    config = ConfigFileLoader(\n        path.join(get_repo_path(), 'io_config.yaml'), 'default'\n    )\n    with MSSQL.with_config(config) as db:\n        db.execute(\n            \"INSERT INTO dbo.etl_audit_log \"\n            \"(pipeline_name, run_date, status, records_processed, error_message) \"\n            f\"VALUES ('steam_staging_{run_mode}', GETDATE(), 'FAILED', 0, N'{err}')\"\n        )\n        db.commit()", "file_path": "/home/src/mage_pipeline/callbacks/log_failure.py", "language": "python", "type": "callback", "uuid": "log_failure"}}, "custom_block_template": {}, "mage_template": {"data_loaders/airtable.py:data_loader:python:Airtable:Load a Table from Airtable App.": {"block_type": "data_loader", "description": "Load a Table from Airtable App.", "language": "python", "name": "Airtable", "path": "data_loaders/airtable.py"}, "data_loaders/deltalake/s3.py:data_loader:python:Amazon S3:Load a Delta Table from Amazon S3.:Delta Lake": {"block_type": "data_loader", "description": "Load a Delta Table from Amazon S3.", "groups": ["Delta Lake"], "language": "python", "name": "Amazon S3", "path": "data_loaders/deltalake/s3.py"}, "data_loaders/deltalake/azure_blob_sto