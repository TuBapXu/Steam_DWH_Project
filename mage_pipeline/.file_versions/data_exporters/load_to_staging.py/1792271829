import os
import pandas as pd
import pyodbc

if 'data_exporter' not in globals():
    from mage_ai.data_preparation.decorators import data_exporter


@data_exporter
def load_to_staging(df, *args, **kwargs):
    # Lấy chế độ chạy, chuẩn hóa về chữ thường
    run_mode = str(kwargs.get('run_mode', 'incremental')).strip().lower()

    # Batch rỗng thì không có gì để nạp
    if df.empty:
        print("Batch rong, khong nap gi.", flush=True)
        return df

    # Đổi NaN/NaT/NA thành None để SQL Server nhận là NULL
    data = df.astype(object).where(df.notna(), None)

    # Tạo câu INSERT từ tên cột của DataFrame
    cols = list(df.columns)
    col_sql = ", ".join(f"[{c}]" for c in cols)
    placeholders = ", ".join("?" for _ in cols)

    # Kết nối trực tiếp bằng pyodbc để tự kiểm soát commit
    conn = pyodbc.connect(
        "DRIVER={ODBC Driver 17 for SQL Server};"
        "SERVER=sqlserver,1433;DATABASE=steam_games_DWH;UID=sa;"
        f"PWD={{{os.getenv('MSSQL_PASSWORD')}}};",
        autocommit=False,
    )
    try:
        cur = conn.cursor()

        if run_mode == 'full':
            # FULL LOAD: xóa sạch rồi nạp lại
            cur.execute("TRUNCATE TABLE dbo.stg_steam_games")
        else:
            # INCREMENTAL: xóa đúng các appid của batch để chạy lại không trùng
            ids = df['appid'].astype('int64').tolist()
            for i in range(0, len(ids), 1000):
                chunk = ",".join(str(x) for x in ids[i:i + 1000])
                cur.execute(
                    f"DELETE FROM dbo.stg_steam_games WHERE appid IN ({chunk})"
                )

        # Nạp hàng loạt (nhanh hơn từng dòng)
        cur.fast_executemany = True
        cur.executemany(
            f"INSERT INTO dbo.stg_steam_games ({col_sql}) VALUES ({placeholders})",
            data.values.tolist(),
        )
        conn.commit()  # Chốt giao dịch

        # Đếm lại số dòng thật trong bảng để kiểm chứng
        cur.execute("SELECT COUNT(*) FROM dbo.stg_steam_games")
        total = cur.fetchone()[0]
    except Exception:
        conn.rollback()  # Lỗi thì hoàn tác
        raise            # Ném lỗi lên để pipeline FAILED, không báo SUCCESS giả
    finally:
        conn.close()

    # Chặn trường hợp "nạp xong nhưng bảng vẫn rỗng"
    if total == 0:
        raise RuntimeError("Nap xong nhung staging van rong")

    print(f"Da nap {len(df)} dong | Tong dong trong staging: {total}", flush=True)
    return df