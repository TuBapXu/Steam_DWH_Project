import pandas as pd 

if 'transformer' not in globals():
    from mage_ai.data_preparation.decorators import transformer

# Các cột BẮT BUỘC phải có trong file CSV (tên gốc, chưa đổi tên)
REQUIRED = ['AppID', 'Name', 'Release date']


@transformer  # Đánh dấu đây là hàm chính của block transformer
def validate_clean(df, *args, **kwargs):
    # df chính là DataFrame mà block extract_steam_games trả về

    # ---------- BƯỚC 0: nếu batch rỗng thì khỏi xử lý ----------
    if df.empty:
        print("Batch rong, bo qua validate.", flush=True)
        return df

    # ---------- BƯỚC 1: KIỂM TRA CẤU TRÚC ----------
    # Liệt kê các cột bắt buộc mà df đang thiếu
    missing = [c for c in REQUIRED if c not in df.columns]
    if missing:
        # Thiếu cột thì dừng pipeline ngay và báo lỗi rõ ràng
        raise ValueError(f"Thieu cot bat buoc: {missing}")

    rows_in = len(df)  # Ghi lại số dòng đầu vào để so sánh cuối block
    df = df.copy()     # Làm việc trên bản sao, tránh cảnh báo SettingWithCopy

    # ---------- BƯỚC 2: CHUẨN HÓA TÊN CỘT ----------
    # "Release date" -> "release_date"; bỏ khoảng trắng, đổi sang chữ thường
    df.columns = [
        c.strip().lower().replace(' ', '_') for c in df.columns
    ]

    # ---------- BƯỚC 3: ÉP KIỂU ----------
    # Ép AppID về số; giá trị không phải số sẽ thành NaN thay vì gây lỗi
    df['appid'] = pd.to_numeric(df['appid'], errors='coerce')
    # Tên game: chuyển về chuỗi và cắt khoảng trắng đầu/cuối
    df['name'] = df['name'].astype(str).str.strip()

    # ---------- BƯỚC 4: KIỂM TRA CHẤT LƯỢNG ----------
    # Đếm số dòng AppID lỗi (NaN) -> sẽ bị loại
    n_bad_key = int(df['appid'].isna().sum())
    # Đếm số dòng ngày lỗi (NaT); chỉ ghi nhận, KHÔNG xóa
    n_bad_date = int(df['release_date'].isna().sum())

    # Bỏ các dòng không có AppID (không có khóa thì không định danh được)
    df = df[df['appid'].notna()]

    # Đếm số dòng trùng AppID
    n_dup = int(df.duplicated('appid').sum())
    # Giữ dòng cuối cùng của mỗi AppID, bỏ các dòng trùng
    df = df.drop_duplicates('appid', keep='last')

    # Giờ AppID đã sạch, đổi sang số nguyên cho gọn
    df['appid'] = df['appid'].astype('int64')

    # ---------- BƯỚC 5: THÊM CỘT METADATA ----------
    # Thời điểm dòng này được nạp (phục vụ audit, truy vết)
    df['_loaded_at'] = pd.Timestamp.now()
    # Chế độ chạy: full hay incremental
    df['_run_mode'] = kwargs.get('run_mode', 'incremental')

    # ---------- BƯỚC 6: GHI NHẬN KẾT QUẢ ----------
    print(
        f"Vao: {rows_in} | AppID loi: {n_bad_key} | Ngay loi: {n_bad_date} "
        f"| Trung AppID: {n_dup} | Ra: {len(df)}",
        flush=True,  # In ngay, không bị buffer trong Docker
    )

    return df  # Trả về cho block load_to_staging
