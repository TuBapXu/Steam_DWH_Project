import pandas as pd
from mage_ai.io.config import ConfigFileLoader
from mage_ai.io.mssql import MSSQL
from mage_ai.settings.repo import get_repo_path
from os import path
if 'data_loader' not in globals():
    from mage_ai.data_preparation.decorators import data_loader

@data_loader
def load_data_from_file(*args, **kwargs):
    #Lay bien tu giao dien
    run_mode = kwargs.get('run_mode', 'incremental')
    demo_lset = kwargs.get('demo_lset', None)
    demo_cet = kwargs.get('demo_cet', None)

    print(f"--- Bắt đầu chạy chế độ: {run_mode.upper()} LOAD ---")

    #Doc file csv goc
    file_path = '/home/src/data/games.csv'
    # Sửa dòng 20 thành:
    df = pd.read_csv(
        file_path, 
        engine='python', 
        on_bad_lines='skip', 
        encoding='utf-8',
        index_col=False,
        quotechar='"'
    )
    
    # Ép kiểu thời gian với format='mixed' để đọc được chuỗi "Aug 1, 2023"
    df['Release date'] = pd.to_datetime(df['Release date'], format='mixed', errors='coerce')
    
    print("--- KIỂM TRA LẠI DỮ LIỆU SAU KHI FIX ---")
    print(df[['AppID', 'Name', 'Release date']].head())

    print("--- 5 DÒNG NGÀY THÁNG ĐẦU TIÊN ---")
    print(df[['Name', 'Release date']].head())

    #Phan nhan full load - incremental load
    if run_mode == 'full':
        print(f"Đang chạy FULL LOAD: Trích xuất toàn bộ {len(df)} dòng, bỏ qua Watermark.")
        return df
    if demo_lset and demo_cet:
        lset = pd.to_datetime(demo_lset)
        cet = pd.to_datetime(demo_cet)
        print(f"[Chế độ DEMO] Cắt lát thủ công từ {lset} đến {cet}")
    else:
        print(">> Đang kết nối SQL Server...")
        print("[Chế dộ thực tế] Đang tự động truy vấn LSET từ SQL server...")
        config_path = path.join(get_repo_path(), 'io_config.yaml')
        query_lset = "SELECT lset FROM etl_watermark Where table_name = 'stg_steam_games'"
        with MSSQL.with_config(ConfigFileLoader(config_path, 'default')) as db:
            result = db.load(query_lset)
            
            lset_str = result.iloc[0, 0] if not result.empty else '2015-01-01'

        lset = pd.to_datetime(lset_str)
        cet = lset + pd.DateOffset(years=2)

    #Loc du lieu lset < batch_df <= cet
    batch_df = df[(df['Release date'] > lset) & (df['Release date'] <= cet)]
    print(f"Hoàn tất! Đã trích xuất {len(batch_df)} tựa game cho batch này")
    return batch_df
